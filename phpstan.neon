includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    universalObjectCratesClasses:
        # Airwallex API objects: their fields are read as properties, like Stripe's StripeObject.
        - App\Billing\Airwallex\AirwallexObject
