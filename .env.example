APP_NAME=ComplyRobin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=complyrobin
# The app's own login; row-level security applies to it.
DB_TENANT_USERNAME=app_tenant
DB_TENANT_PASSWORD=tenant
DB_PLATFORM_USERNAME=app_platform
DB_PLATFORM_PASSWORD=platform
DB_MIGRATOR_USERNAME=app_migrator
DB_MIGRATOR_PASSWORD=migrator
# The database owner: only `php artisan db:roles` uses it (on Laravel Cloud it is injected).
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional: a separate private disk for media. Empty uses FILESYSTEM_DISK.
MEDIA_DISK=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@complyrobin.com"
# Production sends through Resend (MAIL_MAILER=resend); Laravel Cloud's Resend integration sets these.
RESEND_API_KEY=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Team chat channels ComplyRobin offers: slack,teams,telegram. Empty: email, in-app and calendar only.
CHAT_CHANNELS=
# Telegram also needs the bot's token.
TELEGRAM_BOT_TOKEN=
