{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bizexcel/complyrobin",
    "type": "project",
    "description": "ComplyRobin: SaaS credentials register with rotation reminders, and ISO 22301 / ISO 27001 management systems.",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "bezhansalleh/filament-shield": "^4.3",
        "dompdf/dompdf": "^3.1",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-media-library-plugin": "^5.11",
        "laravel/framework": "^13.42",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "propaganistas/laravel-phone": "^6.1",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-permission": "^8.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.3",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --database=pgsql_migrator --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": "pest",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
